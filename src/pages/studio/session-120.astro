const images = [
  {
    "src": "/studio/session-120/01-the-all-hands.png",
    "title": "The All-Hands",
    "caption": "Wide shot of an outdoor breakfast staff meeting in the courtyard of a fantasy fortress estate inside a crystal city. A small Kobold paladin stands on a crate addressing the staff like a corporate manager giving a quarterly update, with a hand-drawn chart on an easel behind him."
  },
  {
    "src": "/studio/session-120/02-no-designation.png",
    "title": "No. Designation.",
    "caption": "Close-up, dramatic moment at a breakfast table: a tall, angular Warforged with dulled lacquer, faded heraldry and a registration mark on his forehead grips the wrist of an eager human tinkerer in goggles and a leather apron. Blue-white lightning arcs from the Warforged's hand up the tinkerer's arm, the tinkerer's hair standing on end and his face frozen in shock."
  },
  {
    "src": "/studio/session-120/03-twelve-has-concerns.png",
    "title": "Twelve Has Concerns",
    "caption": "At night beside a huge bubbling iron cauldron half-buried in a mound of salt, under a tree next to a fortress, a skeptical cranium rat with a glowing exposed brain sits on a druid's shoulder, eyebrow raised, staring into the cauldron. Floating in the brine are the comically disassembled parts of a mind flayer: tentacles, a purple head, an arm, as if waiting to be put back together."
  },
  {
    "src": "/studio/session-120/04-lord-of-the-cranium-rats.png",
    "title": "Lord of the Cranium Rats",
    "caption": "Epic wide shot of a vast sewer cistern beneath a crystal city. Thousands of rats with exposed, pulsing, glowing brains bow in concentric rings around a mind flayer standing on a broken pipe, arms raised like a benevolent dictator."
  },
  {
    "src": "/studio/session-120/05-hey-how-s-it-going.png",
    "title": "Hey, How's It Going?",
    "caption": "A comic scene in a cozy fantasy bathroom: a druid sits on a wooden toilet, robes bunched up, cheerfully chatting into an old-fashioned rotary landline phone mounted on the wall beside him. The cord runs down into the toilet bowl, where a cranium rat with a glowing exposed brain peeks out over the rim, holding a tiny receiver to its ear."
